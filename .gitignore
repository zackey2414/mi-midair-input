# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data: 各サブシステムの中身 (画像 / zip / 生成 index) は git 管理外。
# ディレクトリ構造だけ .gitkeep で残す。
/data/**
!/data/**/
!/data/**/.gitkeep

# モデル比較用の別 index ルート (ViT-B/16 / L/14)。中身は git 管理外、構造だけ残す。
/data-vitb16/**
!/data-vitb16/**/
!/data-vitb16/**/.gitkeep
/data-vitl14/**
!/data-vitl14/**/
!/data-vitl14/**/.gitkeep

# Model cache
.cache/

# Vendored MediaPipe (JS/wasm/model) — ビルド時に fetch_mediapipe.py で取得する。
# git には載せず、Dockerfile / スクリプトで再取得する (CLIP モデルと同方針)。
/packages/web/src/midair_web/static/vendor/

# IDE / OS
.vscode/
.idea/
.DS_Store
